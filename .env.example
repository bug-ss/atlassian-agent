# --- Model -------------------------------------------------------------------
# Required for the default Anthropic model.
ANTHROPIC_API_KEY=sk-ant-...

# Any provider string LangChain's init_chat_model understands. Install that
# provider's package if you change this (e.g. langchain-openai).
# ATLASSIAN_AGENT_MODEL=anthropic:claude-opus-5

# --- Atlassian MCP server ----------------------------------------------------
# The current endpoint. Legacy /v1/mcp still works; /v1/sse is retired after
# 2026-06-30.
# ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp

# OAuth scopes, space- or comma-separated. Changing these invalidates the
# cached login and sends you through the browser again.
# Drop the write:* entries for a read-only agent. Trim products your site has
# not enabled if authorization is rejected with invalid_scope.
# ATLASSIAN_OAUTH_SCOPES=offline_access read:me read:account read:jira:agent-interface write:jira:agent-interface search:jira:agent-interface read:confluence:agent-interface write:confluence:agent-interface search:confluence:agent-interface search:rovo:agent-interface

# --- OAuth loopback ----------------------------------------------------------
# Where the browser sends the authorization code back. Host and port are part
# of the registered redirect URI, so changing either forces a re-registration.
# Atlassian accepts any loopback host and any port (verified against its
# registration and authorize endpoints), so both are free to move.
# ATLASSIAN_OAUTH_CALLBACK_HOST=127.0.0.1
# ATLASSIAN_OAUTH_CALLBACK_PORT=8901
# ATLASSIAN_OAUTH_CALLBACK_PATH=/oauth/callback
# ATLASSIAN_OAUTH_TIMEOUT=300

# Where tokens and the dynamic client registration are cached (mode 0600).
# ATLASSIAN_TOKEN_CACHE=~/.atlassian-agent/tokens.json

# --- Transport timeouts ------------------------------------------------------
# ATLASSIAN_MCP_TIMEOUT=60
# ATLASSIAN_MCP_SSE_READ_TIMEOUT=300
